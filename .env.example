# Copy to .env and fill in. The .env file is not committed.

# Password for the "rag" Postgres user. Must match docker-compose.yml.
POSTGRES_PASSWORD=

# Full connection string. Overrides POSTGRES_PASSWORD when set.
# DATABASE_URL=postgresql://rag:password@localhost:5433/ragdb

# Generation model. Every number in the README was measured on gemma4:e4b —
# changing the model makes those numbers incomparable.
# GEN_MODEL=gemma4:e4b

# Model for the verification pass. Must be from a DIFFERENT family than the
# generator: a judge from the same family is blind in the same places.
# JUDGE_MODEL=qwen3:8b

# Model for LLM query expansion (query_llm.py). Used only by the earlier BGE-M3
# pipeline and the sweep.py configurations with expansion; the default Ruri
# configuration does not expand queries and never calls it.
# LLM_MODEL=gemma4:e4b
