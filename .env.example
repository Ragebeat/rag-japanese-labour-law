# Скопировать в .env и заполнить. Файл .env в git не попадает.

# Пароль пользователя rag в Postgres. Должен совпадать с docker-compose.yml.
POSTGRES_PASSWORD=

# Полная строка подключения — переопределяет POSTGRES_PASSWORD, если задана.
# DATABASE_URL=postgresql://rag:пароль@localhost:5433/ragdb

# Модель генерации. Все замеры в README получены на gemma4:e4b —
# смена модели делает цифры несравнимыми.
# GEN_MODEL=gemma4:e4b

# Модель второго прохода. Должна быть ДРУГОГО семейства, чем генератор:
# судья того же семейства слеп там же, где генератор.
# JUDGE_MODEL=qwen3:8b
